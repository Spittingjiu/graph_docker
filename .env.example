# 时区
TZ=Asia/Shanghai

# 运行模式：loop（常驻容器智能定时调度，推荐） / once（单次执行退出，适合宿主机外部 crontab）
RUN_MODE=loop

# 常驻模式下巡检间隔（小时），默认 6 小时
RUN_INTERVAL_HOURS=6

# 随机时间浮动（分钟），默认 30 分钟（即 6 小时 ± 30 分钟，离散模拟真实活动）
JITTER_MINUTES=30

# Telegram 通知模式：summary（默认，每轮只发一条汇总报表） / all（每次接口调用均发） / error（仅出错时发送）
TG_NOTIFY_MODE=summary

# 可选：Telegram 通知配置（两者同时填写才会启用通知）
TG_BOT_TOKEN=
TG_SEND_ID=

# Microsoft Entra 应用配置（必填）
CLIENT_ID=
CLIENT_SECRET=

# 租户：默认 common（个人/多租户都可）
TENANT_ID=common

# 首次可留空，先跑 ./graphctl auth 自动写入 token.txt
TOKEN_FIRST=

# 可选：Telegram 反代域名，不填或 null 走官方 api.telegram.org
PROXY_URL=null

# 可选：true 则调用补充 API（需要额外权限）
IS_API_URLS_EXTEND=false

# API 调用模式：full(默认，全量接口) / lite(极简接口)
GRAPH_API_PROFILE=full

# 高级：自定义 API（逗号分隔），配置后会覆盖 profile
# GRAPH_APIS=/me,/me/drive

# OAuth 配置（一般不用改）
REDIRECT_URI=http://localhost:53682/
AUTH_SCOPES=offline_access openid profile User.Read

# 请求超时（秒）
REQUEST_TIMEOUT=15

# 批次调用参数
CYCLE_MIN=3
CYCLE_MAX=5
API_SLEEP_MIN=3
API_SLEEP_MAX=6
LOOP_SLEEP_MIN=20
LOOP_SLEEP_MAX=40
