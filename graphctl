#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR"

cmd="${1:-help}"

case "$cmd" in
  up)
    mkdir -p data
    touch token.txt
    docker compose up -d --build
    ;;
  down)
    docker compose down
    ;;
  logs)
    docker compose logs -f --tail="${2:-100}"
    ;;
  test|run-once)
    mkdir -p data
    touch token.txt
    echo "[test] 正在以单次批处理模式运行一次测试..."
    docker compose run --rm -e RUN_MODE=once ms_graph_docker python3 -u main.py
    ;;
  status)
    echo "====== 服务状态 ======"
    docker compose ps || true
    echo
    echo "====== Token 状态 ======"
    token_file="token.txt"
    [[ -f "data/token.txt" ]] && token_file="data/token.txt"
    if [[ -f "$token_file" && -s "$token_file" ]]; then
      token_len="$(wc -c < "$token_file" | tr -d ' ')"
      token_mod="$(date -r "$token_file" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || stat -c '%y' "$token_file" 2>/dev/null || echo '未知')"
      echo "文件: $token_file (存在，大小: ${token_len} 字节，更新时间: ${token_mod})"
    else
      echo "文件: $token_file (不存在或为空，请执行 ./graphctl auth 进行首次授权)"
    fi
    echo
    echo "====== 最近日志 (最后 15 行) ======"
    docker compose logs --tail=15 2>/dev/null || echo "暂无日志"
    ;;
  auth)
    mkdir -p data
    touch token.txt
    docker compose run --rm ms_graph_docker python3 /app/auth_cli.py
    ;;
  tenant-init)
    if [[ -z "${GRAPH_BOOTSTRAP_TOKEN:-}" ]]; then
      echo "请先导出 GRAPH_BOOTSTRAP_TOKEN（具备 Graph 应用管理权限）"
      echo "例如: export GRAPH_BOOTSTRAP_TOKEN='eyJ...'"
      exit 1
    fi
    mkdir -p data
    touch token.txt
    docker compose run --rm -e GRAPH_BOOTSTRAP_TOKEN="$GRAPH_BOOTSTRAP_TOKEN" ms_graph_docker python3 /app/tenant_init.py
    ;;
  check)
    failures=()
    warnings=()

    echo "[check] 执行环境与服务自检中..."

    # 1) .env 基础校验
    if [[ -f .env ]]; then
      env_ok="OK"
      client_id_val="$(grep -E '^CLIENT_ID=' .env | head -n1 | cut -d= -f2- || true)"
      client_secret_val="$(grep -E '^CLIENT_SECRET=' .env | head -n1 | cut -d= -f2- || true)"
      if [[ -z "$client_id_val" || -z "$client_secret_val" ]]; then
        warnings+=(".env 存在，但 CLIENT_ID/CLIENT_SECRET 可能未配置完整")
      fi
    else
      env_ok="MISSING"
      failures+=("缺少 .env 文件（请从 .env.example 复制配置）")
    fi

    # 2) compose 配置校验
    if [[ "$env_ok" == "OK" ]]; then
      if docker compose config >/dev/null 2>&1; then
        compose_ok="OK"
      else
        compose_ok="FAIL"
        failures+=("docker compose 配置解析失败")
      fi
    else
      compose_ok="SKIPPED"
    fi

    # 3) 容器网络到微软登录端点
    if [[ "$env_ok" == "OK" ]]; then
      set +e
      net_output="$(docker compose run --rm ms_graph_docker sh -lc "python3 - <<'PY'
import requests, sys
url='https://login.microsoftonline.com/common/discovery/v2.0/keys'
try:
    r=requests.get(url, timeout=10)
    print(f'status={r.status_code}')
    sys.exit(0 if r.status_code < 500 else 2)
except Exception as e:
    print(f'error={e!r}')
    sys.exit(1)
PY" 2>&1)"
      net_rc=$?
      set -e
      if [[ $net_rc -eq 0 ]]; then
        net_ok="OK"
      else
        net_ok="FAIL"
        failures+=("容器无法正常访问 Microsoft 登录端点，请检查网络或 DNS")
      fi
    else
      net_ok="SKIPPED"
      warnings+=("因缺少 .env 配置，已跳过网络连通性测试")
    fi

    # 4) 主服务运行状态
    if docker compose ps --services --status running 2>/dev/null | grep -qx 'ms_graph_docker'; then
      svc_ok="RUNNING"
    else
      svc_ok="STOPPED"
      warnings+=("服务未在后台运行（配置完成后可执行: ./graphctl up）")
    fi

    echo
    echo "====== 自检结论 ======"
    echo ".env 文件:   $env_ok"
    echo "compose 配置: $compose_ok"
    echo "网络连通:   $net_ok"
    echo "服务状态:   $svc_ok"

    if [[ ${#warnings[@]} -gt 0 ]]; then
      echo
      echo "⚠️ 提示："
      for w in "${warnings[@]}"; do
        echo "- $w"
      done
    fi

    if [[ ${#failures[@]} -eq 0 ]]; then
      echo
      echo "✅ 结论：核心检查全部通过。"
    else
      echo
      echo "❌ 结论：发现 ${#failures[@]} 个问题："
      for f in "${failures[@]}"; do
        echo "- $f"
      done
      echo
      echo "建议：先配置 .env 并执行 ./graphctl auth，随后启动服务。"
      exit 1
    fi
    ;;
  clean)
    echo "将执行一键清除：停止容器 + 删除本地数据(.env/token) + 删除镜像"
    read -r -p "确认继续？(yes/no): " ans
    if [[ "$ans" != "yes" ]]; then
      echo "已取消"
      exit 0
    fi

    # 可选：同时删除云端 Entra 应用注册
    read -r -p "是否同时删除云端应用注册（Entra）?(yes/no): " purge_cloud
    if [[ "$purge_cloud" == "yes" ]]; then
      if [[ -z "${GRAPH_BOOTSTRAP_TOKEN:-}" ]]; then
        echo "未检测到 GRAPH_BOOTSTRAP_TOKEN，跳过云端删除。"
        echo "如需删除云端应用，请先导出 GRAPH_BOOTSTRAP_TOKEN 后重试 clean。"
      elif [[ ! -f .env ]]; then
        echo "未检测到 .env，无法读取 CLIENT_ID，跳过云端删除。"
      else
        echo "开始尝试删除云端应用注册..."
        set +e
        docker compose run --rm -e GRAPH_BOOTSTRAP_TOKEN="$GRAPH_BOOTSTRAP_TOKEN" ms_graph_docker sh -lc "python3 - <<'PY'
import os
import requests

token = os.getenv('GRAPH_BOOTSTRAP_TOKEN', '').strip()
client_id = os.getenv('CLIENT_ID', '').strip()

if not token or not client_id:
    raise SystemExit(0)

headers = {
    'Authorization': f'Bearer {token}',
    'Content-Type': 'application/json',
}
base = 'https://graph.microsoft.com/v1.0'

resp = requests.get(
    f'{base}/applications',
    headers=headers,
    params={
        '$filter': f"appId eq '{client_id}'",
        '$select': 'id,appId,displayName',
    },
    timeout=20,
)

if resp.status_code >= 400:
    print(f'cloud-delete lookup failed: {resp.status_code} {resp.text[:300]}')
    raise SystemExit(1)

apps = resp.json().get('value', [])
if not apps:
    print('cloud-delete: no matching application found')
    raise SystemExit(0)

ok = True
for app in apps:
    app_obj_id = app.get('id')
    name = app.get('displayName', '')
    r = requests.delete(f'{base}/applications/{app_obj_id}', headers=headers, timeout=20)
    if r.status_code in (204, 200):
        print(f'cloud-delete: removed app {name} ({app_obj_id})')
    else:
        ok = False
        print(f'cloud-delete failed: {r.status_code} {r.text[:300]}')

raise SystemExit(0 if ok else 1)
PY"
        cloud_rc=$?
        set -e
        if [[ $cloud_rc -eq 0 ]]; then
          echo "云端应用删除流程执行完成。"
        else
          echo "云端应用删除失败（本地清除仍会继续）。"
        fi
      fi
    fi

    docker compose down --remove-orphans || true
    docker image rm -f graph_docker:local >/dev/null 2>&1 || true
    rm -rf .env token.txt data
    echo "清除完成"
    ;;
  help|*)
    cat <<'EOF'
用法: ./graphctl <command>

常用命令:
  up          启动容器后台运行（自动构建镜像）
  down        停止并销毁容器
  test        以单次批处理模式运行一次测试并输出完整调用日志
  status      查看服务运行状态、Token 状态与最近日志
  logs        查看容器实时日志（默认100行，如: ./graphctl logs 200）
  auth        运行首次授权向导（交互式获取 refresh_token）
  tenant-init 自动化初始化 Azure AD 应用与 .env（需提供 GRAPH_BOOTSTRAP_TOKEN）
  check       执行环境与连通性自检
  clean       一键完全清除本地配置、Token 与容器数据
EOF
    ;;
esac
